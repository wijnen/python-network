#!/usr/bin/make -f

export PYBUILD_NAME = network

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	dh_auto_build
	doxygen config.doxygen
	if [ -e doxygen-output/html/jquery.js ] ; then \
		rm -f doxygen-output/html/jquery.js ; \
		ln -sf /usr/share/javascript/jquery/jquery.js doxygen-output/html/ ; \
	fi

override_dh_auto_clean:
	dh_auto_clean
	rm -rf doxygen-output network_wrapper.egg-info dist
